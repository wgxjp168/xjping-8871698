# ILbuy 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改

# ─── Redis ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ILbuy@Redis2024

# ─── JWT ─────────────────────────────────
JWT_SECRET=ILbuy@JWT@SecretKey@2024@Production

# ─── 服务端口 ─────────────────────────────
GATEWAY_PORT=8080
USER_SERVICE_PORT=8001
PROCUREMENT_SERVICE_PORT=8002
AI_SERVICE_PORT=8003
ORDER_SERVICE_PORT=8004
DATA_SERVICE_PORT=8005

# ─── 服务发现（本地进程模式） ───────────────
USER_SERVICE_URL=http://localhost:8001
PROCUREMENT_SERVICE_URL=http://localhost:8002
AI_SERVICE_URL=http://localhost:8003
ORDER_SERVICE_URL=http://localhost:8004
DATA_SERVICE_URL=http://localhost:8005

# ─── 生产环境额外配置 ─────────────────────
