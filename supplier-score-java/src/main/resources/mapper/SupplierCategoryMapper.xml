<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ilbuy.supplier.mapper.SupplierCategoryMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO supplier_category (cate_name, sort, status, create_time, update_time)
        VALUES (#{cateName}, #{sort}, #{status}, NOW(), NOW())
    </insert>

    <update id="updateById">
        UPDATE supplier_category
        <set>
            <if test="cateName != null and cateName != ''">cate_name = #{cateName},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM supplier_category WHERE id = #{id}
    </delete>

    <select id="selectById" resultType="SupplierCategory">
        SELECT * FROM supplier_category WHERE id = #{id}
    </select>

    <select id="selectList" resultType="SupplierCategory">
        SELECT * FROM supplier_category
        <where>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY sort ASC, id ASC
    </select>

</mapper>
