# 惠东县区域公卫体检集中系统 - 微服务通用Dockerfile
# 用法（从项目根目录执行）：
#   docker build --build-arg SERVICE_NAME=physical-auth \
#                --build-arg SERVICE_PORT=9005 \
#                -t physical/auth:1.0.0 \
#                -f deploy/Dockerfile.service .

FROM eclipse-temurin:11-jre-alpine AS runtime

# ---- 构建参数 ----
ARG SERVICE_NAME
ARG SERVICE_PORT=8080
ARG JAR_FILE

# ---- 环境变量 ----
ENV SERVICE_NAME=${SERVICE_NAME} \
    SERVER_PORT=${SERVICE_PORT} \
    TZ=Asia/Shanghai \
    JAVA_OPTS="-server \
      -Xms256m -Xmx512m \
      -XX:+UseG1GC \
      -XX:MaxGCPauseMillis=200 \
      -XX:+HeapDumpOnOutOfMemoryError \
      -XX:HeapDumpPath=/var/log/physical/heapdump.hprof \
      -Djava.security.egd=file:/dev/./urandom \
      -Dfile.encoding=UTF-8 \
      -Duser.timezone=Asia/Shanghai"

# ---- 时区 & 工具 ----
RUN apk add --no-cache tzdata curl && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    # 创建日志目录
    mkdir -p /var/log/physical && \
    # 创建非root运行用户，减小攻击面
    addgroup -S physical && adduser -S -G physical physical

WORKDIR /app

# ---- 复制jar包（Maven构建产物） ----
# JAR_FILE 格式示例：physical-auth/target/physical-auth-1.0.0.jar
COPY ${SERVICE_NAME}/target/${SERVICE_NAME}-*.jar app.jar

# 以非root用户运行
USER physical

EXPOSE ${SERVICE_PORT}

# 健康检查（使用Actuator）
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${SERVICE_PORT}/actuator/health/liveness || exit 1

ENTRYPOINT ["sh", "-c", "exec java ${JAVA_OPTS} \
  -Dserver.port=${SERVER_PORT} \
  -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE:-prod} \
  -jar app.jar"]
