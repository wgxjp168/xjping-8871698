# ============================================================
# ILbuy L2 AI Decision Hub — Environment Variables
# ============================================================

# --- Auth (L1 service) ---
AUTH_SVC_URL=http://auth-svc:8001
JWT_SECRET=change-me-in-production

# --- Redis (session store) ---
REDIS_URL=redis://redis:6379
REDIS_TTL=3600

# --- Service Discovery ---
INTENT_SVC_URL=http://intent-svc:8010
LLM_SVC_URL=http://llm-svc:8011
DECISION_SVC_URL=http://decision-svc:8012
DIALOG_SVC_URL=http://dialog-svc:8013

# --- LLM API Keys ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-6
WENXIN_API_KEY=
WENXIN_SECRET_KEY=
# Primary LLM provider: openai | anthropic | wenxin
LLM_PROVIDER=anthropic

# --- NLP ---
HF_MODEL_NAME=hfl/chinese-roberta-wwm-ext
NLP_DEVICE=cpu

# --- L3 Downstream (预留) ---
L3_DATA_SVC_URL=http://data-svc:8020
L3_PRODUCT_SVC_URL=http://product-svc:8021

# --- Logging ---
LOG_LEVEL=INFO
ENV=development
