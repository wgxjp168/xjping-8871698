{
  "title": "ILbuy — 业务指标看板",
  "uid": "ilbuy-business-metrics",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["ilbuy", "business"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "推荐准确率 (L2)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus-ilbuy" },
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.60 },
            { "color": "green", "value": 0.75 }
          ]
        }
      },
      "targets": [
        {
          "expr": "avg(ilbuy_recommendation_accuracy_ratio{namespace=\"ilbuy-l2\"})",
          "legendFormat": "准确率",
          "datasource": { "uid": "prometheus-ilbuy" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "交付成功率 (L6)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus-ilbuy" },
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.90 },
            { "color": "green", "value": 0.98 }
          ]
        }
      },
      "targets": [
        {
          "expr": "ilbuy:l6:delivery_success_rate5m",
          "legendFormat": "成功率",
          "datasource": { "uid": "prometheus-ilbuy" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "支付成功率 (L7)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus-ilbuy" },
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.95 },
            { "color": "green", "value": 0.99 }
          ]
        }
      },
      "targets": [
        {
          "expr": "ilbuy:l7:payment_success_rate5m",
          "legendFormat": "成功率",
          "datasource": { "uid": "prometheus-ilbuy" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "正面反馈率 (L8)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus-ilbuy" },
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.60 },
            { "color": "green", "value": 0.80 }
          ]
        }
      },
      "targets": [
        {
          "expr": "ilbuy:l8:feedback_positive_rate30m",
          "legendFormat": "正面率",
          "datasource": { "uid": "prometheus-ilbuy" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "当前模型版本年龄 (天)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus-ilbuy" },
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 14 },
            { "color": "red", "value": 30 }
          ]
        }
      },
      "targets": [
        {
          "expr": "ilbuy:l8:model_age_days",
          "legendFormat": "天",
          "datasource": { "uid": "prometheus-ilbuy" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "d" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "推荐请求速率 & AI决策层吞吐 (L2)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus-ilbuy" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "ilbuy:l2:recommendation_rate5m",
          "legendFormat": "{{ service }}",
          "datasource": { "uid": "prometheus-ilbuy" }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "交付 & 支付事务速率 (L6/L7)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus-ilbuy" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum(rate(ilbuy_delivery_total{namespace=\"ilbuy-l6\"}[5m]))",
          "legendFormat": "L6 交付 TPS",
          "datasource": { "uid": "prometheus-ilbuy" }
        },
        {
          "expr": "sum(rate(ilbuy_payment_total{namespace=\"ilbuy-l7\"}[5m]))",
          "legendFormat": "L7 支付 TPS",
          "datasource": { "uid": "prometheus-ilbuy" }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "反馈情感分布趋势 (L8)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus-ilbuy" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "sum(rate(ilbuy_feedback_total{namespace=\"ilbuy-l8\", sentiment=\"POSITIVE\"}[5m]))",
          "legendFormat": "正面",
          "datasource": { "uid": "prometheus-ilbuy" }
        },
        {
          "expr": "sum(rate(ilbuy_feedback_total{namespace=\"ilbuy-l8\", sentiment=\"NEUTRAL\"}[5m]))",
          "legendFormat": "中性",
          "datasource": { "uid": "prometheus-ilbuy" }
        },
        {
          "expr": "sum(rate(ilbuy_feedback_total{namespace=\"ilbuy-l8\", sentiment=\"NEGATIVE\"}[5m]))",
          "legendFormat": "负面",
          "datasource": { "uid": "prometheus-ilbuy" }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "模型训练任务状态 (L8)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus-ilbuy" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "increase(ilbuy_training_job_total{namespace=\"ilbuy-l8\", status=\"SUCCESS\"}[1h])",
          "legendFormat": "成功",
          "datasource": { "uid": "prometheus-ilbuy" }
        },
        {
          "expr": "increase(ilbuy_training_job_failed_total{namespace=\"ilbuy-l8\"}[1h])",
          "legendFormat": "失败",
          "datasource": { "uid": "prometheus-ilbuy" }
        }
      ]
    }
  ]
}
