# ============================================================
# ILbuy 微服务 Docker Compose 环境变量
# ============================================================

COMPOSE_PROJECT_NAME=ilbuy-services

# ── 镜像 ──────────────────────────────────────────────────
REGISTRY=registry.cn-hangzhou.aliyuncs.com/ilbuy
IMAGE_TAG=latest

# ── Spring Profile ─────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC

# ── Nacos ─────────────────────────────────────────────────
NACOS_DEV_NS=ilbuy-dev

# ── MySQL ─────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=ilbuy123

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=ilbuy123

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ── MinIO ─────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── 服务端口 ───────────────────────────────────────────────
GATEWAY_PORT=8080
USER_SVC_PORT=8081
PRODUCT_SVC_PORT=8082
ORDER_SVC_PORT=8083
SUPPLIER_SVC_PORT=8084
FINANCE_SVC_PORT=8086
MESSAGE_SVC_PORT=8087
BIZ_DATA_PORT=8088
AI_SVC_PORT=8089

# ── LLM Keys（生产环境从 Vault 注入）─────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
