# ============================================================
# ILbuy 中间件 Docker Compose 环境变量
# 复制此文件为 .env.local 后修改，.env.local 已加入 .gitignore
# ============================================================

# ── 基础 ─────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=ilbuy-middleware
DATA_DIR=./data               # 数据持久化目录（相对于 docker-compose.yml）

# ── MySQL ─────────────────────────────────────────────────
MYSQL_VERSION=8.0.36
MYSQL_ROOT_PASSWORD=ilbuy123
MYSQL_PORT=3306

# ── Redis ─────────────────────────────────────────────────
REDIS_VERSION=7.2-alpine
REDIS_PORT=6379
REDIS_PASSWORD=ilbuy123

# ── Elasticsearch ─────────────────────────────────────────
ES_VERSION=8.11.4
ES_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m
ELASTIC_PASSWORD=ilbuy123

# ── Kibana ────────────────────────────────────────────────
KIBANA_PORT=5601

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_VERSION=3.12-management
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ── Nacos ─────────────────────────────────────────────────
NACOS_VERSION=v2.3.2
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_AUTH_ENABLE=false

# ── MinIO ─────────────────────────────────────────────────
MINIO_VERSION=RELEASE.2024-01-16T16-07-38Z
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── ClickHouse ────────────────────────────────────────────
CLICKHOUSE_VERSION=23.12
CLICKHOUSE_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_PASSWORD=

# ── Canal ─────────────────────────────────────────────────
CANAL_VERSION=v1.1.7
CANAL_PORT=11111
