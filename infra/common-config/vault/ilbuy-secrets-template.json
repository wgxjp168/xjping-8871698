{
  "_comment": "ILbuy Vault Secret 模板 — 生产部署前替换所有 <REPLACE_ME> 值",
  "_usage": [
    "1. 替换所有 <REPLACE_ME> 为实际值",
    "2. 执行: vault kv put secret/ilbuy/<path> key=value ...",
    "3. 或使用批量导入脚本: bash vault-import.sh"
  ],

  "db": {
    "user_db": {
      "host":     "<REPLACE_ME: MySQL主库IP>",
      "port":     "3306",
      "name":     "user_db",
      "username": "ilbuy_user",
      "password": "<REPLACE_ME: 强密码>"
    },
    "order_db": {
      "host":     "<REPLACE_ME>",
      "port":     "3306",
      "name":     "order_db",
      "username": "ilbuy_order",
      "password": "<REPLACE_ME>"
    },
    "product_db": {
      "host":     "<REPLACE_ME>",
      "port":     "3306",
      "name":     "product_db",
      "username": "ilbuy_product",
      "password": "<REPLACE_ME>"
    },
    "finance_db": {
      "host":     "<REPLACE_ME>",
      "port":     "3306",
      "name":     "finance_db",
      "username": "ilbuy_finance",
      "password": "<REPLACE_ME>"
    },
    "supplier_db": {
      "host":     "<REPLACE_ME>",
      "port":     "3306",
      "name":     "ilbuy_supplier",
      "username": "ilbuy_supplier",
      "password": "<REPLACE_ME>"
    },
    "message_db": {
      "host":     "<REPLACE_ME>",
      "port":     "3306",
      "name":     "message_db",
      "username": "ilbuy_message",
      "password": "<REPLACE_ME>"
    }
  },

  "redis": {
    "nodes":    "<node1:6379,node2:6379,node3:6379,node4:6379,node5:6379,node6:6379>",
    "password": "<REPLACE_ME>"
  },

  "jwt": {
    "secret":           "<REPLACE_ME: 至少 32 字节随机字符串>",
    "expire-hours":     "24",
    "refresh-expire-days": "7"
  },

  "storage": {
    "minio": {
      "endpoint":   "https://minio.ilbuy.internal",
      "access-key": "<REPLACE_ME>",
      "secret-key": "<REPLACE_ME>"
    }
  },

  "payment": {
    "alipay": {
      "app-id":      "<REPLACE_ME>",
      "private-key": "<REPLACE_ME: PKCS8格式>",
      "public-key":  "<REPLACE_ME: 支付宝公钥>"
    },
    "wechat-pay": {
      "mch-id":  "<REPLACE_ME>",
      "api-key": "<REPLACE_ME>"
    }
  },

  "llm": {
    "anthropic": {
      "api-key": "<REPLACE_ME: sk-ant-...>"
    },
    "openai": {
      "api-key": "<REPLACE_ME: sk-...>"
    },
    "qwen": {
      "api-key": "<REPLACE_ME>"
    }
  },

  "api-keys": {
    "aliyun-sms": {
      "access-key-id":     "<REPLACE_ME>",
      "access-key-secret": "<REPLACE_ME>"
    },
    "wechat": {
      "app-id":     "<REPLACE_ME>",
      "app-secret": "<REPLACE_ME>"
    },
    "bank-verify": {
      "api-key": "<REPLACE_ME>"
    }
  },

  "notification": {
    "mail": {
      "username": "<REPLACE_ME: SMTP账号>",
      "password": "<REPLACE_ME: SMTP密码>"
    }
  }
}
