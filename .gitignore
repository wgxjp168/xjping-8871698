test-results/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# SQLite 开发数据库
*.db
*.sqlite
*.sqlite3

# ── Node.js / Frontend ────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
.pnp.*

# Frontend build output
dist/
build/
.next/
.nuxt/
.cache/

# ── Docker / 环境变量 ─────────────────────────────────────
