.env.local
.env.*.local
infra/docker-compose/middleware/.env.local
infra/docker-compose/services/.env.local

# ── 运行时数据目录 ────────────────────────────────────────
data/
logs/
*.log
*.log.*

# ── 备份文件 ──────────────────────────────────────────────
*.bak
*.backup
*.sql.gz
*.rdb.gz

# ── 密钥 / 证书（绝对不提交）────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.gpg
vault-token
.vault-token
secrets/
credentials/

# 含实际密码的本地配置
application-prod.yml
application-prod.properties
application-local.yml
application-local.properties
bootstrap-prod.yml
bootstrap-local.yml

# ── OS ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── 临时文件 ──────────────────────────────────────────────
*.tmp
*.temp
*.swp
*.swo
*~

# ── 测试报告 ──────────────────────────────────────────────
test-output/
surefire-reports/
failsafe-reports/
allure-results/
allure-report/

