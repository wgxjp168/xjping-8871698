<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.health.mapper.CheckResultMapper">

    <resultMap id="CheckResultVOMap" type="com.health.vo.CheckResultVO">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="item_id" property="itemId"/>
        <result column="item_name" property="itemName"/>
        <result column="category" property="category"/>
        <result column="value" property="value"/>
        <result column="unit" property="unit"/>
        <result column="normal_range" property="normalRange"/>
        <result column="flag" property="flag"/>
        <result column="device_id" property="deviceId"/>
        <result column="device_name" property="deviceName"/>
        <result column="data_source" property="dataSource"/>
        <result column="doctor_id" property="doctorId"/>
        <result column="doctor_name" property="doctorName"/>
        <result column="remark" property="remark"/>
        <result column="check_time" property="checkTime"/>
    </resultMap>

    <select id="getResultsByOrderId" resultMap="CheckResultVOMap">
        SELECT cr.*,
               ci.category,
               d.name AS device_name,
               u.real_name AS doctor_name
        FROM check_result cr
        LEFT JOIN check_item ci ON cr.item_id = ci.id
        LEFT JOIN device d ON cr.device_id = d.id
        LEFT JOIN sys_user u ON cr.doctor_id = u.id
        WHERE cr.order_id = #{orderId}
        ORDER BY ci.sort ASC, cr.check_time ASC
    </select>

</mapper>
